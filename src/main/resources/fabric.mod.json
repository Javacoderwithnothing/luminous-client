
{
  "schemaVersion": 1,
  "id": "luminous client",
  "version": "${version}",
  "name": "luminous client",
  "description": "A custom Minecraft client built by luminous.",
  "authors": [
    "luminous client"
  ],
  "contact": {
    "sources": "YOUR_GITHUB_REPOSITORY_URL"
  },
  "license": "CC0-1.0",
  "icon": "assets/modid/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.ExampleMod"
    ],
    "client": [
      "com.example.client.LuminousClient"
    ]
  },
  "mixins": [
    "modid.mixins.json",
    {
      "config": "modid.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
